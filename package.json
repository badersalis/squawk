{
  "name": "@squawk/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "serve:schedule": "cross-env OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317 nx serve @squawk/schedule",
    "serve:search": "cross-env OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317 SCHEDULE_SERVICE_URL=http://localhost:3000 REDIS_URL=redis://localhost:6380 nx serve @squawk/search"
  },
  "private": true,
  "devDependencies": {
    "@eslint/js": "^9.8.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@nx/eslint": "23.2.0",
    "@nx/eslint-plugin": "23.2.0",
    "@nx/js": "23.2.0",
    "@nx/nest": "^23.2.0",
    "@nx/node": "23.2.0",
    "@nx/vite": "^23.2.0",
    "@nx/vitest": "23.2.0",
    "@nx/web": "23.2.0",
    "@nx/webpack": "23.2.0",
    "@swc-node/register": "1.11.1",
    "@swc/core": "1.15.8",
    "@swc/helpers": "0.5.18",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "~4.1.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "jsonc-eslint-parser": "^2.1.0",
    "nx": "23.2.0",
    "prettier": "^3.8.1",
